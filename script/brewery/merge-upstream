#!/usr/bin/env bash
# Merges Zed's main into the current branch and resolves the conflicts that
# always resolve the same way. Exits 1 and lists what is left for a human.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Tracked files have uncommitted changes; commit or stash them first."
  exit 1
fi

git fetch --filter=blob:none upstream main

if git merge-base --is-ancestor upstream/main HEAD; then
  echo "Already up to date with upstream/main."
  exit 0
fi

# A conflict makes git exit non-zero; that is expected, so keep going.
git merge --no-ff --no-edit --no-commit upstream/main || true

if ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  echo "Merge did not start; see git output above."
  exit 1
fi

while IFS= read -r path; do
  case "$path" in
    .github/workflows/brewery_*) ;;
    .github/workflows/*) git rm -q --ignore-unmatch -- "$path" ;;
    README.md|CONTRIBUTING.md|CODE_OF_CONDUCT.md|.github/ISSUE_TEMPLATE/*|.github/DISCUSSION_TEMPLATE/*|.github/pull_request_template.md)
      if git cat-file -e "HEAD:$path" 2>/dev/null; then
        git checkout --ours -- "$path" && git add "$path"
      else
        git rm -q --ignore-unmatch -- "$path"
      fi ;;
  esac
done < <(git diff --name-only --diff-filter=U)

# Zed's own GitHub files that Brewery removed stay removed, even when upstream changes them.
for path in .github/FUNDING.yml .github/renovate.json .github/ISSUE_TEMPLATE/11_crash_report.yml   .github/DISCUSSION_TEMPLATE/feature-requests.yml; do
  if ! git cat-file -e "HEAD:$path" 2>/dev/null; then git rm -q -f --ignore-unmatch -- "$path"; fi
done
while IFS= read -r path; do
  git rm -q -f -- "$path"
done < <(git ls-files .github/actions)

# Upstream may add new workflows without conflicting; drop them too.
while IFS= read -r path; do
  git rm -q -f -- "$path"
done < <(git ls-files .github/workflows | { grep -v '/brewery_' || true; })

remaining=$(git diff --name-only --diff-filter=U)
if [ -n "$remaining" ]; then
  echo "Resolve these by hand, then run 'git commit':"
  echo "$remaining"
  exit 1
fi

git commit --no-edit
echo "Merged upstream/main."
