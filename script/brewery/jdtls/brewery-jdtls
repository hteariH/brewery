#!/bin/sh
# Brewery's jdtls launcher for Linux and macOS. Starts the Eclipse JDT Language
# Server of this bundle without Python (jdtls's own bin/jdtls needs it).
#
# Brewery sets it as lsp.jdtls.settings.jdtls_launcher. The Java extension
# (6.8.28, src/jdtls_server.rs) then runs it through java-lsp-proxy as
#     brewery-jdtls [--jvm-arg=<JVM option>]... [-data <workspace>]
# and speaks LSP over stdin/stdout, so only jdtls may write to stdout.
# The JVM arguments match the extension's own build_jdtls_launch_args.
#
#   java       <bundle>/jre/bin/java, else $JAVA_HOME/bin/java, else PATH
#   Gradle     $JAVA_HOME (see brewery.gradle.java.home below)
#   config     shared, read-only: <bundle>/jdtls/config_<os>[_arm]
#              writable: <cache>/config/<sha1 of this jdtls directory>
#   workspace  -data when given, else <cache>/workspace/jdtls-<sha1 of the cwd>;
#              rebuilt when this jdtls changes (see the stamp below)
#   cache      $BREWERY_JDTLS_CACHE_DIR, else ~/Library/Caches/Brewery/jdtls
#              (macOS) or ${XDG_CACHE_HOME:-~/.cache}/brewery/jdtls
#
# --jvm-arg X and --jvm-arg=X both work; every other argument goes to jdtls
# after -data.
set -eu

die() {
    echo "brewery-jdtls: $*" >&2
    exit 1
}

# Single-quote one argument for the eval below.
quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

sha1() {
    if command -v sha1sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha1sum | cut -c1-40
    elif command -v shasum >/dev/null 2>&1; then
        printf '%s' "$1" | shasum -a 1 | cut -c1-40
    elif command -v openssl >/dev/null 2>&1; then
        printf '%s' "$1" | openssl sha1 | sed 's/^.*= *//'
    else
        printf '%s' "$1" | cksum | cut -d ' ' -f 1
    fi
}

jdtls_home=$(cd "$(dirname -- "$0")" && pwd -P)
bundle_root=$(dirname -- "$jdtls_home")

java_from_home=no
if [ -x "$bundle_root/jre/bin/java" ]; then
    java=$bundle_root/jre/bin/java
elif [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    java=$JAVA_HOME/bin/java
    java_from_home=yes
else
    java=java
fi

# Gradle (jdtls's import and builds) runs on the user's JDK, as gradlew does:
# JAVA_HOME reaches jdtls as brewery.gradle.java.home, which Brewery's
# lsp.jdtls.initialization_options use for java.import.gradle.java.home. It is
# empty without a usable JAVA_HOME, when jdtls runs on it (then it is jdtls's
# default JVM anyway) or when the project's Gradle wrapper cannot run on it;
# jdtls then picks a JDK that wrapper can run on.

# The JDK's feature version from its release file (1.8.0_x is 8); 0 if unknown.
java_feature() {
    version=$(sed -n 's/^JAVA_VERSION="\{0,1\}\([^"]*\)"\{0,1\}.*$/\1/p' "$1/release" 2>/dev/null | head -n 1)
    case $version in
        1.*) version=${version#1.} ;;
    esac
    version=${version%%[!0-9]*}
    echo "${version:-0}"
}

# The wrapper's Gradle version (.../gradle-8.10.2-bin.zip) as major*100+minor; 0 if unknown.
gradle_number() {
    url=$(sed -n 's/^distributionUrl=//p' gradle/wrapper/gradle-wrapper.properties 2>/dev/null | head -n 1)
    name=${url##*/}
    version=${name#gradle-}
    [ "$version" != "$name" ] || { echo 0; return; }
    major=${version%%.*}
    case $version in
        *.*) rest=${version#*.} && minor=${rest%%[!0-9]*} ;;
        *) minor= ;;
    esac
    case $major$minor in
        '' | *[!0-9]*) echo 0 ;;
        *) [ -n "$minor" ] && echo $((major * 100 + minor)) || echo 0 ;;
    esac
}

# The oldest Gradle that runs on Java $1 (jdtls's GradleUtils.getHighestSupportedJava;
# https://docs.gradle.org/current/userguide/compatibility.html); "" when none is known.
min_gradle() {
    min=
    for pair in 0:0 9:403 10:407 11:500 12:504 13:600 14:603 15:607 16:700 17:703 18:705 \
        19:706 20:803 21:805 22:808 23:810 24:814 25:901 26:904; do
        [ "$1" -ge "${pair%%:*}" ] && min=${pair#*:}
    done
    [ "$1" -ge 27 ] && min=
    echo "$min"
}

gradle_java_home=
if [ "$java_from_home" = no ] && [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    gradle_java_home=${JAVA_HOME%/}
    feature=$(java_feature "$gradle_java_home")
    gradle=$(gradle_number)
    if [ "$feature" -gt 0 ] && [ "$gradle" -gt 0 ]; then
        min=$(min_gradle "$feature")
        if [ -z "$min" ] || [ "$gradle" -lt "$min" ] || { [ "$feature" -lt 17 ] && [ "$gradle" -ge 900 ]; }; then
            gradle_java_home=
        fi
    fi
fi

launcher=
if [ -f "$jdtls_home/plugins/org.eclipse.equinox.launcher.jar" ]; then
    launcher=$jdtls_home/plugins/org.eclipse.equinox.launcher.jar
else
    for jar in "$jdtls_home"/plugins/org.eclipse.equinox.launcher_*.jar; do
        if [ -f "$jar" ]; then
            launcher=$jar
        fi
    done
fi
[ -n "$launcher" ] || die "no org.eclipse.equinox.launcher jar in $jdtls_home/plugins"

case $(uname -s) in
    Darwin) os=mac ;;
    *) os=linux ;;
esac
case $(uname -m) in
    arm64 | aarch64) shared=$jdtls_home/config_${os}_arm ;;
    *) shared=$jdtls_home/config_$os ;;
esac
[ -f "$shared/config.ini" ] || die "$shared/config.ini not found"

jvm_args=
jdtls_args=
data=
while [ $# -gt 0 ]; do
    case $1 in
        --jvm-arg=*)
            jvm_args="$jvm_args $(quote "${1#--jvm-arg=}")"
            ;;
        --jvm-arg)
            [ $# -ge 2 ] || die "--jvm-arg needs a value"
            shift
            jvm_args="$jvm_args $(quote "$1")"
            ;;
        -data)
            [ $# -ge 2 ] || die "-data needs a value"
            shift
            data=$1
            ;;
        *)
            jdtls_args="$jdtls_args $(quote "$1")"
            ;;
    esac
    shift
done

cache=${BREWERY_JDTLS_CACHE_DIR:-}
if [ -z "$cache" ]; then
    if [ "$os" = mac ]; then
        cache=$HOME/Library/Caches/Brewery/jdtls
    else
        cache=${XDG_CACHE_HOME:-$HOME/.cache}/brewery/jdtls
    fi
fi
config_area=$cache/config/$(sha1 "$jdtls_home")
if [ -z "$data" ]; then
    data=$cache/workspace/jdtls-$(sha1 "$(pwd)")
fi

# A workspace remembers paths into the configuration area: Gradle projects keep
# "--init-script <config>/org.eclipse.osgi/<bundle id>/0/.cp/gradle/init/init.gradle"
# in their Buildship settings. When this jdtls is replaced (a Brewery update),
# Equinox reinstalls its bundles under new ids and those paths stop existing, so
# Gradle imports fail until the workspace is rebuilt. The stamp names this jdtls;
# a workspace from another one (or from before the stamp) is moved away and
# deleted, and jdtls imports the project again.
file_stamp() {
    for f in "$@"; do
        [ -e "$f" ] || continue
        printf '|%s|' "${f##*/}"
        stat -c '%s|%Y' "$f" 2>/dev/null || stat -f '%z|%m' "$f" 2>/dev/null || echo '?'
    done
}
stamp="$config_area$(file_stamp "$shared/config.ini" "$jdtls_home"/plugins/org.eclipse.jdt.ls.core_*.jar)"
stamp_file=$data/.metadata/brewery-jdtls.stamp
if [ ! -f "$stamp_file" ] || [ "$(cat "$stamp_file" 2>/dev/null)" != "$stamp" ]; then
    wiped=yes
    if [ -d "$data/.metadata" ]; then
        stale=$data.stale-$$
        if mv "$data" "$stale" 2>/dev/null; then
            rm -rf "$stale" 2>/dev/null || true
        else
            wiped=no
        fi
    fi
    if [ "$wiped" = yes ] && mkdir -p "$data/.metadata" 2>/dev/null; then
        printf '%s\n' "$stamp" >"$stamp_file" 2>/dev/null || true
    fi
fi

eval "exec \"\$java\" \
    -Declipse.application=org.eclipse.jdt.ls.core.id1 \
    -Dosgi.bundles.defaultStartLevel=4 \
    -Declipse.product=org.eclipse.jdt.ls.core.product \
    -Dosgi.checkConfiguration=true \
    \"-Dosgi.sharedConfiguration.area=\$shared\" \
    -Dosgi.sharedConfiguration.area.readOnly=true \
    -Dosgi.configuration.cascaded=true \
    \"-Dosgi.configuration.area=\$config_area\" \
    -Djava.import.generatesMetadataFilesAtProjectRoot=false \
    -Djava.net.preferIPv4Stack=true \
    \"-Dbrewery.gradle.java.home=\$gradle_java_home\" \
    -Xms1G \
    --add-modules=ALL-SYSTEM \
    --add-opens java.base/java.util=ALL-UNNAMED \
    --add-opens java.base/java.lang=ALL-UNNAMED \
    $jvm_args \
    -jar \"\$launcher\" \
    -data \"\$data\" \
    $jdtls_args"
